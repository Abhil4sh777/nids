# The shell scripts and systemd unit run on Linux.  This machine (and any
# Windows clone) must not rewrite them to CRLF: `bash install.sh` fails with
# stray \r characters, and the USB bundle copies files byte-for-byte.
*.sh             text eol=lf
*.service        text eol=lf
deploy/*.example text eol=lf
deploy/requirements-pi.txt text eol=lf
