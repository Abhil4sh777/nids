# NIDS runtime configuration for the Raspberry Pi (read by nids.service).
#
# Rendered by deploy/install.sh from this template on first install and then
# never overwritten: edit /etc/nids/nids.env and run
#     sudo systemctl restart nids
# Every key is a real setting from config.py; NIDS_-prefixed aliases exist for
# the bare LLM_BACKEND / EXECUTORCH_* names.
#
# The detection contract (feature lists, 0.3545 detector threshold, attack
# names) lives in app/features/contract.py and is deliberately not configurable.

# ---- Core -------------------------------------------------------------
NIDS_ROOT=@PREFIX@/app
LLM_BACKEND=executorch
# XGBoost must stay on the CPU; any other value is rejected at load time.
NIDS_XGB_DEVICE=cpu

# ---- Capture ----------------------------------------------------------
# Filled by the installer from --interface or the first wired interface.
NIDS_INTERFACE=@INTERFACE@
NIDS_CAPTURE_DIR=@DATA_DIR@/pcaps
NIDS_OUTPUT_DIR=@DATA_DIR@/flows
# Spare the SD card: finished captures are deleted after extraction.
NIDS_PCAP_AFTER_PROCESS=delete
NIDS_PCAP_ROTATION=60
NIDS_PCAP_RING=10
NIDS_PCAP_STABLE=3
NIDS_CAPTURE_POLL=2

# ---- Flow extraction --------------------------------------------------
# Either the NTLFlowLyzer checkout installed by --ntlflowlyzer, or the
# executable name once NTLFlowLyzer is installed in the venv.
NIDS_NTLFLOWLYZER=@NTLFLOWLYZER@
# The Pi is CPU-bound and shared: two extractor processes is the default.
NIDS_NTLFLOWLYZER_THREADS=2
NIDS_NTLFLOWLYZER_TIMEOUT=300
NIDS_NTLFLOWLYZER_ACTIVITY_TIMEOUT=60
NIDS_NTLFLOWLYZER_MAX_FLOW_DURATION=600

# ---- Models -----------------------------------------------------------
NIDS_MODEL_DIR=@PREFIX@/app/models
NIDS_KNOWLEDGE_DIR=@PREFIX@/app/explain/knowledge

# ---- Explanation backend (ExecuTorch, CPU) ----------------------------
# 4k is the window baked into the .pte and the default for an 8 GB Pi.
EXECUTORCH_PTE_PATH=@LLM_DIR@/xnnpack/Llama-3.2-1B-Instruct-8da4w-gptq-4k.pte
EXECUTORCH_TOKENIZER_PATH=@LLM_DIR@/tokenizer.json
# The stock runner is ExecuTorch's llama_main; the backend appends
# --model_path/--tokenizer_path/--prompt_file/--max_new_tokens/--temperature.
EXECUTORCH_RUNNER_PATH=@PREFIX@/bin/executorch_llama_runner
EXECUTORCH_WINDOW=4096
EXECUTORCH_TIMEOUT_S=180
EXECUTORCH_RESERVED_OUTPUT_TOKENS=256
EXECUTORCH_TEMPERATURE=0.2

# ---- Alert grouping / dashboard --------------------------------------
NIDS_ALERT_GROUP_WINDOW=60
NIDS_ALERT_QUEUE_SIZE=32
NIDS_HISTORY_LIMIT=300
NIDS_UI_REFRESH=2
# Start live capture on the configured interface as soon as the dashboard
# loads, so the appliance works unattended.  Set to 0 to start it by hand.
NIDS_AUTOSTART=@AUTOSTART@

# ---- Streamlit --------------------------------------------------------
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_PORT=@PORT@
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
